{%- style -%}
  .fill-bag-section {
    padding: 6rem 0;
    background-color: #ffffff;
    width: 100vw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    text-align: center;
  }

  .fill-bag-container {
    max-width: 800px;
    width: 90%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Shakes briefly, then rests */
  @keyframes gentle-shake {
    0% { transform: rotate(0deg); }
    5%, 15%, 25% { transform: rotate(-3deg); }
    10%, 20%, 30% { transform: rotate(3deg); }
    35%, 100% { transform: rotate(0deg); }
  }

  .fill-bag-image-wrapper {
    display: inline-block;
    margin-bottom: 2rem;
    animation: gentle-shake 4s infinite ease-in-out;
  }

  .fill-bag-image {
    max-width: 400px;
    width: 100%;
    height: auto;
    display: block;
    margin: 0 auto;
    filter: drop-shadow(0 15px 30px rgba(0,0,0,0.1));
  }

  .fill-bag-text {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    color: #111;
    margin-bottom: 2.5rem;
    line-height: 1.3;
  }

  .fill-bag-btn {
    display: inline-block;
    padding: 1rem 3rem;
    background-color: #111;
    color: #fff;
    font-family: 'Inter', sans-serif;
    font-weight: 500;
    font-size: 1.1rem;
    text-decoration: none;
    border-radius: 30px;
    transition: all 0.3s ease;
  }

  .fill-bag-btn:hover {
    background-color: #333;
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(0,0,0,0.2);
  }

  @media screen and (max-width: 768px) {
    .fill-bag-section {
      width: 100vw;
      position: relative;
      left: 50%;
      right: 50%;
      margin-left: -50vw;
      margin-right: -50vw;
      padding: 4rem 0;
    }
    .fill-bag-image {
      max-width: 280px;
    }
  }

  /* Force wrapper to have no margin at bottom */
  #shopify-section-{{ section.id }} {
    margin-bottom: 0 !important;
  }
{%- endstyle -%}

<section class="fill-bag-section" id="FillBag-{{ section.id }}">
  <div class="fill-bag-container">
    <div class="fill-bag-image-wrapper">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'fill-bag-image' }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg fill-bag-image' }}
      {%- endif -%}
    </div>
    
    {%- if section.settings.text != blank -%}
      <h2 class="fill-bag-text">{{ section.settings.text }}</h2>
    {%- endif -%}
    
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: '/collections/all' }}" class="fill-bag-btn">
        {{ section.settings.button_label }}
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Fill Bag Prompt",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Bag/Box Image"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Prompt Text",
      "default": "Your bag feels light, fill it out."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Fill Bag Prompt"
    }
  ]
}
{% endschema %}
