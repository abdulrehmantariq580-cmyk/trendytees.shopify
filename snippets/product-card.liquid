<div class="product-card">
  <div class="product-card__image-container">
    {%- if product.compare_at_price > product.price -%}
      <span class="product-card__badge-sale">Sale</span>
    {%- endif -%}
    
    <a href="{{ product.url | default: '#' }}" class="product-card__image-link">
      {%- if product.featured_image != blank -%}
        <img 
          src="{{ product.featured_image | image_url: width: 600 }}" 
          alt="{{ product.featured_image.alt | escape }}"
          class="product-card__image product-card__image--primary"
          loading="lazy"
          width="600"
          height="800"
        >

      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg product-card__image' }}
      {%- endif -%}
    </a>
  </div>

  <div class="product-card__info">
    <a href="{{ product.url | default: '#' }}" class="product-card__title-link">
      <h3 class="product-card__title">{{ product.title | default: 'Example T-Shirt' }}</h3>
    </a>
    <div class="product-card__price-wrapper">
      {%- if product.compare_at_price > product.price -%}
        <s class="product-card__price--regular">{{ product.compare_at_price | money }}</s>
        <span class="product-card__price--sale">{{ product.price | money }}</span>
      {%- else -%}
        <span class="product-card__price">{{ product.price | default: 249900 | money }}</span>
      {%- endif -%}
    </div>
  </div>
</div>

{%- style -%}
  .product-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    background-color: transparent;
  }

  .product-card__image-container {
    position: relative;
    width: 100%;
    padding-bottom: 110%; /* Slightly portrait */
    overflow: hidden;
    background-color: #fff;
    border-radius: 16px; /* Rounded corners */
    border: 1px solid #111; /* Dark border */
  }

  .product-card__badge-sale {
    position: absolute;
    top: 20px; /* Moved to top */
    left: 50%;
    transform: translateX(-50%); /* Centered horizontally */
    background: #111;
    color: #fff;
    padding: 6px 14px;
    border-radius: 0; /* Rectangular shape */
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 1px;
    z-index: 2;
  }

  .product-card__image-link {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .product-card__image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.4s ease, transform 0.4s ease;
  }



  .product-card__info {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1rem 0 0 0; /* Padding only at top */
    flex-grow: 1; /* Pushes bottom area if titles vary */
  }

  .product-card__title-link {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-grow: 1; /* Title link takes up remaining space */
  }

  .product-card__title {
    margin: 0;
    font-family: 'Inter', sans-serif; /* Sans serif */
    text-transform: uppercase;
    font-size: 0.95rem;
    font-weight: 500;
    color: #111;
    letter-spacing: 0.5px;
    line-height: 1.4;
  }

  .product-card__price-wrapper {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    align-items: flex-start;
    margin-top: auto; /* Pushes price to the bottom */
  }

  .product-card__price,
  .product-card__price--sale {
    font-family: 'Inter', sans-serif;
    font-weight: 400;
    font-size: 1.1rem;
    color: #111;
  }

  .product-card__price--regular {
    color: #555;
    font-size: 0.9rem;
    text-decoration: line-through;
  }
{%- endstyle -%}
